# ============================================================
# Eastern AI — agent-engine (BACKEND)
# Copy this file to .env.local and fill in your values.
# NEVER put real secrets in this file — it gets committed to git.
# ============================================================

# --- Supabase (server with full DB access) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- LLM (Google Gemini) ---
GEMINI_API_KEY=AIza_replace_me

# --- WhatsApp (Whapi.cloud) ---
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=replace_me_with_per_tenant_token
# Partner key (only needed when auto-creating channels for new tenants).
# Leave blank for v1.
WHAPI_PARTNER_KEY=

# --- Shared secret with frontend (must match VITE_AGENT_ENGINE_SECRET) ---
# Generate with: openssl rand -hex 32
AGENT_ENGINE_SECRET=generate_a_64_char_random_string

# --- HMAC for /admin/replay endpoint (different random string) ---
ADMIN_HMAC_SECRET=generate_another_64_char_random_string

# --- Server config ---
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_TIMEZONE=Africa/Accra
TRIAL_MSG_LIMIT=50
QUIET_HOUR_START=22
QUIET_HOUR_END=7

# --- Optional (leave blank to disable) ---
RESEND_API_KEY=
SENTRY_DSN=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
