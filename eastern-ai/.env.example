# ============================================================
# Eastern AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# Supabase — get these from your project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# n8n Webhooks — base URL of your n8n instance
# Example: https://your-n8n.yourdomain.com/webhook
VITE_N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook

# Shared secret sent as X-Eastern-AI-Secret header on all webhook calls
# Generate a strong random string: openssl rand -hex 32
VITE_N8N_SECRET=your-strong-random-webhook-secret

# Payment portal fallback URL (used if n8n payment session webhook is not configured)
# Example: Paystack, Flutterwave, or any checkout link
VITE_PAYMENT_PORTAL_URL=https://paystack.com/pay/your-plan-link
